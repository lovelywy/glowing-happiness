    "color": "",
    "bgcolor": "#00BCD4",
    "icon": "",
    "payload": "ON",
    "payloadType": "str",
    "topic": "home/relay/4",
    "topicType": "str",
    "x": 140, "y": 600,
    "wires": [["mqtt-out-relay"]]
  },
  {
    "id": "mqtt-out-relay",
    "type": "mqtt out",
    "z": "tab-smarthome",
    "name": "Relay Out",
    "topic": "",
    "qos": "0",
    "retain": false,
    "broker": "mqtt-broker",
    "x": 380, "y": 520,
    "wires": []
  },

  {
    "id": "mqtt-broker",
    "type": "mqtt-broker",
    "name": "Local Mosquitto",
