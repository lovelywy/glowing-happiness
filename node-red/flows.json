    "label": "💡 ไฟห้องนอน OFF",
    "tooltip": "",
    "color": "",
    "bgcolor": "#607D8B",
    "icon": "",
    "payload": "OFF",
    "payloadType": "str",
    "topic": "home/relay/1",
    "topicType": "str",
    "x": 140, "y": 480,
    "wires": [["mqtt-out-relay"]]
  },
  {
    "id": "btn-relay-2-on",
    "type": "ui_button",
    "z": "tab-smarthome",
    "name": "ไฟห้องนั่งเล่น ON",
    "group": "group-relay",
    "order": 3,
    "width": 3, "height": 1,
    "passthru": false,
    "label": "💡 ไฟห้องนั่งเล่น ON",
    "tooltip": "",
    "color": "",
    "bgcolor": "#2196F3",
    "icon": "",
    "payload": "ON",
    "payloadType": "str",
    "topic": "home/relay/2",
    "topicType": "str",
    "x": 140, "y": 520,
    "wires": [["mqtt-out-relay"]]
  },
  {
    "id": "btn-relay-3-toggle",
    "type": "ui_button",
    "z": "tab-smarthome",
    "name": "Toggle พัดลม",
    "group": "group-relay",
    "order": 5,
    "width": 3, "height": 1,
    "passthru": false,
    "label": "🌀 Toggle พัดลม",
    "tooltip": "",
    "color": "",
    "bgcolor": "#4CAF50",
    "icon": "",
    "payload": "TOGGLE",
    "payloadType": "str",
    "topic": "home/relay/3",
    "topicType": "str",
    "x": 140, "y": 560,
    "wires": [["mqtt-out-relay"]]
  },
  {
    "id": "btn-water-now",
    "type": "ui_button",
    "z": "tab-smarthome",
    "name": "รดน้ำทันที",
    "group": "group-relay",
    "order": 7,
    "width": 3, "height": 1,
    "passthru": false,
    "label": "💧 รดน้ำทันที",
