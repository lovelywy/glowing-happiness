[
  {
    "id": "tab-smarthome",
    "type": "tab",
    "label": "Smart Home",
    "disabled": false,
    "info": ""
  },

  {
    "id": "mqtt-in-climate",
    "type": "mqtt in",
    "z": "tab-smarthome",
    "name": "Climate Sensor",
    "topic": "home/sensor/climate",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker",
    "x": 120, "y": 80,
    "wires": [["json-climate", "gauge-temp", "gauge-hum"]]
  },
  {
    "id": "json-climate",
    "type": "json",
    "z": "tab-smarthome",
    "name": "",
    "x": 320, "y": 80,
    "wires": [["gauge-temp", "gauge-hum"]]
  },
  {
    "id": "gauge-temp",
    "type": "ui_gauge",
    "z": "tab-smarthome",
    "name": "Temperature",
    "group": "group-climate",
    "order": 1,
    "width": 3, "height": 3,
    "gtype": "gage",
    "title": "อุณหภูมิ (°C)",
    "label": "°C",
    "format": "{{msg.payload.temp}}",
    "min": "15", "max": "45",
    "colors": ["#00b4d8","#f4d35e","#ee6055"],
    "seg1": "25", "seg2": "32",
    "x": 520, "y": 60,
    "wires": []
  },
  {
    "id": "gauge-hum",
    "type": "ui_gauge",
    "z": "tab-smarthome",
    "name": "Humidity",
    "group": "group-climate",
    "order": 2,
    "width": 3, "height": 3,
    "gtype": "gage",
    "title": "ความชื้น (%)",
    "label": "%",
    "format": "{{msg.payload.humidity}}",
    "min": "0", "max": "100",
    "colors": ["#f4d35e","#00b4d8","#023e8a"],
    "seg1": "40", "seg2": "70",
    "x": 520, "y": 100,
    "wires": []
  },

  {
    "id": "mqtt-in-motion",
    "type": "mqtt in",
    "z": "tab-smarthome",
    "name": "Motion Sensor",
    "topic": "home/sensor/motion",
    "qos": "0",
    "datatype": "utf8",
    "broker": "mqtt-broker",
    "x": 120, "y": 200,
    "wires": [["motion-switch"]]
  },
  {
    "id": "motion-switch",
    "type": "switch",
    "z": "tab-smarthome",
    "name": "Motion?",
    "property": "payload",
    "rules": [{"t":"eq","v":"DETECTED","vt":"str"}],
    "x": 300, "y": 200,
    "wires": [["motion-notify"]]
  },
  {
    "id": "motion-notify",
    "type": "ui_notification",
    "z": "tab-smarthome",
    "name": "Motion Alert",
    "group": "group-security",
    "width": 0, "height": 0,
    "title": "⚠️ ตรวจพบการเคลื่อนไหว",
    "raw": false,
    "border": "#dd0000",
    "timeout": "5",
    "x": 480, "y": 200,
    "wires": []
  },

  {
    "id": "mqtt-in-energy",
    "type": "mqtt in",
    "z": "tab-smarthome",
    "name": "Energy",
    "topic": "home/sensor/energy",
    "qos": "0",
    "datatype": "json",
    "broker": "mqtt-broker",
    "x": 120, "y": 320,
    "wires": [["gauge-watts", "chart-energy"]]
  },
  {
    "id": "gauge-watts",
    "type": "ui_gauge",
    "z": "tab-smarthome",
    "name": "Power",
    "group": "group-energy",
    "order": 1,
    "width": 3, "height": 3,
    "gtype": "donut",
    "title": "พลังงาน (W)",
    "label": "W",
    "format": "{{msg.payload.watts}}",
    "min": "0", "max": "2000",
    "colors": ["#00b4d8","#f4d35e","#ee6055"],
    "seg1": "500", "seg2": "1000",
    "x": 320, "y": 300,
    "wires": []
  },
  {
    "id": "chart-energy",
    "type": "ui_chart",
    "z": "tab-smarthome",
    "name": "Energy Chart",
    "group": "group-energy",
    "order": 2,
    "width": 6, "height": 4,
    "label": "กราฟพลังงาน",
    "chartType": "line",
    "legend": "false",
    "xformat": "HH:mm",
    "interpolate": "linear",
    "nodata": "ไม่มีข้อมูล",
    "dot": false,
    "ymin": "0", "ymax": "2000",
    "x": 320, "y": 340,
    "wires": []
  },

  {
    "id": "btn-relay-1-on",
